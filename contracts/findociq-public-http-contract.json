{
  "bundle_version": "1.0",
  "endpoints": {
    "/extract": {
      "development_request": "ExtractRequest",
      "production_request": "ProductionExtractRequest",
      "response": "ExtractResponse"
    },
    "/v1/applications/{application_id}/documents": {
      "request": "RetentionDeleteRequest",
      "response": "RetentionDeleteResponse"
    },
    "/v1/document-batches": {
      "request": "IngestBatchRequest",
      "response": "IngestBatchResponse"
    },
    "/v1/documents": {
      "request": "IngestDocumentRequest",
      "response": "IngestDocumentResponse"
    },
    "/v1/ingestion-activity/{batch_id}": {
      "response": "IngestionActivityResponse"
    }
  },
  "schemas": {
    "ExtractRequest": {
      "additionalProperties": false,
      "properties": {
        "document_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "question_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    },
    "ExtractResponse": {
      "$defs": {
        "BoundingBox": {
          "properties": {
            "x0": {
              "type": "number"
            },
            "x1": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            }
          },
          "required": [
            "x0",
            "y0",
            "x1",
            "y1"
          ],
          "type": "object"
        },
        "ExtractedFigure": {
          "properties": {
            "citation": {
              "$ref": "#/$defs/SourceCitation"
            },
            "label": {
              "type": "string"
            },
            "period": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "value",
            "citation"
          ],
          "type": "object"
        },
        "SourceCitation": {
          "properties": {
            "bbox": {
              "$ref": "#/$defs/BoundingBox"
            },
            "document_id": {
              "type": "string"
            },
            "page_number": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "document_id",
            "page_number",
            "bbox"
          ],
          "type": "object"
        }
      },
      "properties": {
        "application_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contract_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "type": "string"
        },
        "figures": {
          "items": {
            "$ref": "#/$defs/ExtractedFigure"
          },
          "minItems": 1,
          "type": "array"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "figures"
      ],
      "type": "object"
    },
    "IngestBatchRequest": {
      "$defs": {
        "IngestDocumentRequest": {
          "additionalProperties": false,
          "properties": {
            "application_id": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 3,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "command_id": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 8,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "content_base64": {
              "minLength": 8,
              "type": "string"
            },
            "contract_version": {
              "default": "1.0",
              "enum": [
                "1.0",
                "2.0"
              ],
              "type": "string"
            },
            "filename": {
              "maxLength": 240,
              "minLength": 5,
              "pattern": "^[^/\\\\]+\\.[Pp][Dd][Ff]$",
              "type": "string"
            },
            "policy_hash": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "filename",
            "sha256",
            "content_base64"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contract_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/IngestDocumentRequest"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "documents"
      ],
      "type": "object"
    },
    "IngestBatchResponse": {
      "$defs": {
        "IngestDocumentResponse": {
          "properties": {
            "application_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "chunk_count": {
              "minimum": 1,
              "type": "integer"
            },
            "chunk_ids": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "config_hash": {
              "type": "string"
            },
            "contract_version": {
              "default": "1.0",
              "enum": [
                "1.0",
                "2.0"
              ],
              "type": "string"
            },
            "dlp_receipt_sha256": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "document_id": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "ownership_receipt_sha256": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "page_count": {
              "minimum": 1,
              "type": "integer"
            },
            "policy_hash": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "scan_receipt_sha256": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "scan_status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "sha256": {
              "type": "string"
            },
            "storage_receipt_sha256": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "document_id",
            "filename",
            "sha256",
            "page_count",
            "chunk_count",
            "chunk_ids",
            "config_hash"
          ],
          "type": "object"
        }
      },
      "properties": {
        "contract_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/IngestDocumentResponse"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "documents"
      ],
      "type": "object"
    },
    "IngestDocumentRequest": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_base64": {
          "minLength": 8,
          "type": "string"
        },
        "contract_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "type": "string"
        },
        "filename": {
          "maxLength": 240,
          "minLength": 5,
          "pattern": "^[^/\\\\]+\\.[Pp][Dd][Ff]$",
          "type": "string"
        },
        "policy_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "sha256",
        "content_base64"
      ],
      "type": "object"
    },
    "IngestDocumentResponse": {
      "properties": {
        "application_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "chunk_count": {
          "minimum": 1,
          "type": "integer"
        },
        "chunk_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "config_hash": {
          "type": "string"
        },
        "contract_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "type": "string"
        },
        "dlp_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "document_id": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "ownership_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page_count": {
          "minimum": 1,
          "type": "integer"
        },
        "policy_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scan_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scan_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "type": "string"
        },
        "storage_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "document_id",
        "filename",
        "sha256",
        "page_count",
        "chunk_count",
        "chunk_ids",
        "config_hash"
      ],
      "type": "object"
    },
    "IngestionActivityResponse": {
      "$defs": {
        "IngestionActivityEvent": {
          "properties": {
            "batch_id": {
              "type": "string"
            },
            "completed": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "document_count": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "document_index": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "document_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "message": {
              "type": "string"
            },
            "occurred_at": {
              "format": "date-time",
              "type": "string"
            },
            "sequence": {
              "minimum": 1,
              "type": "integer"
            },
            "stage": {
              "type": "string"
            },
            "total": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "sequence",
            "batch_id",
            "stage",
            "message"
          ],
          "type": "object"
        }
      },
      "properties": {
        "batch_id": {
          "type": "string"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/IngestionActivityEvent"
          },
          "type": "array"
        },
        "last_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "batch_id",
        "status",
        "last_sequence"
      ],
      "type": "object"
    },
    "ProductionExtractRequest": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "maxLength": 200,
          "minLength": 3,
          "type": "string"
        },
        "command_id": {
          "maxLength": 200,
          "minLength": 8,
          "type": "string"
        },
        "contract_version": {
          "const": "2.0",
          "default": "2.0",
          "type": "string"
        },
        "document_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "application_id",
        "document_ids",
        "metric_ids",
        "command_id"
      ],
      "type": "object"
    },
    "RetentionDeleteRequest": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "maxLength": 200,
          "minLength": 8,
          "type": "string"
        },
        "contract_version": {
          "const": "2.0",
          "default": "2.0",
          "type": "string"
        }
      },
      "required": [
        "command_id"
      ],
      "type": "object"
    },
    "RetentionDeleteResponse": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "2.0",
          "default": "2.0",
          "type": "string"
        },
        "deleted_document_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "application_id",
        "deleted_document_ids",
        "receipt_sha256",
        "policy_hash"
      ],
      "type": "object"
    }
  },
  "service": "findociq",
  "supported_contract_versions": [
    "1.0",
    "2.0"
  ]
}
